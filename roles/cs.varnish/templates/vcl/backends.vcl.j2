{# minimal #}
probe app_probe { .request="HEAD {{ varnish_backend_probe_endpoint }} HTTP/1.1""Host: localhost""Connection: close"; .interval=1s; .timeout=1s; .threshold=2; .window=3; }
probe pwa_probe { .request="HEAD / HTTP/1.1""Host: localhost""Connection: close"; .interval=1s; .timeout=1s; .threshold=2; .window=3; }
{% if gtm_enabled|default(false) %}
probe gtm_probe { .request="GET /healthy HTTP/1.1""Host: localhost""Connection: close"; .interval=1s; .timeout=1s; .threshold=2; .window=3; }
{% endif %}

{% set defs = [
  {"pfx":"", "port": varnish_backend_port, "probe":"app_probe", "mc": varnish_backend_max_conns},
  {"pfx":"pwa_", "port":"8083", "probe":"pwa_probe", "mc": varnish_backend_max_conns}
] %}
{% if gtm_enabled|default(false) %}
{% set _ = defs.append({"pfx":"gtm_", "port":"8080", "probe":"gtm_probe", "mc": varnish_backend_max_conns}) %}
{% set _ = defs.append({"pfx":"gtm_preview", "port":"8081", "probe":"gtm_probe", "mc": varnish_backend_max_conns}) %}
{% endif %}

{% for d in defs %}
{% for i in (varnish_backend_instances_app + varnish_backend_instances_extra) %}
backend {{ d.pfx }}{{ i.instance_id|replace('-','') }} {
  .host="{{ i.private_ip_address }}"; .port="{{ d.port }}";
  .max_connections={{ d.mc }}; .probe={{ d.probe }};
  .first_byte_timeout={{ varnish_backend_first_byte_timeout }};
  .connect_timeout=5s; .between_bytes_timeout=60s;
}
{% endfor %}
{% endfor %}

sub backends_init {
  new app_director=directors.round_robin();
{% for i in varnish_backend_instances_app %} app_director.add_backend({{ i.instance_id|replace('-','') }});{% endfor %}
  new pwa_director=directors.round_robin();
{% for i in varnish_backend_instances_app %} pwa_director.add_backend(pwa_{{ i.instance_id|replace('-','') }});{% endfor %}
{% if gtm_enabled|default(false) %}
  new gtm_director=directors.round_robin();
{% for i in varnish_backend_instances_app %} gtm_director.add_backend(gtm_{{ i.instance_id|replace('-','') }});{% endfor %}
  new gtm_preview_director=directors.round_robin();
{% for i in varnish_backend_instances_app %} gtm_preview_director.add_backend(gtm_preview{{ i.instance_id|replace('-','') }});{% endfor %}
{% endif %}
  new extra_director=directors.round_robin();
{% for i in varnish_backend_instances_extra %} extra_director.add_backend({{ i.instance_id|replace('-','') }});{% endfor %}
}