{{ magento_live_release_dir }}/var/log/*.log {{ magento_live_release_dir }}/var/log/*/*.log {
    rotate 2
    create 0664 root root
    su root root
    notifempty
    compress
    compresscmd /usr/bin/zstd
    uncompresscmd /usr/bin/unzstd
    compressext .zstd
    compressoptions -19
    size 128M
    missingok
}
