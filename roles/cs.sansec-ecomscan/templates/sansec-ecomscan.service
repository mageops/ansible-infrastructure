[Unit]
Description=Sansec eComscan monitoring
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ sansec_ecomscan_user }}
EnvironmentFile=/etc/default/sansec-ecomscan
{% if sansec_ecomscan_only_cron_node | bool %}
ExecCondition=/usr/local/bin/mageopscli is_cron_node
{% endif %}
ExecStart={{ sansec_ecomscan_binary_path }} --monitor={{ sansec_ecomscan_monitor | quote }} {{ sansec_ecomscan_extra_args }} {{ magento_live_release_dir | quote }}
